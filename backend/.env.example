# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://luxmed:luxmed@localhost:5433/luxmedicine

# The least-privileged DB role the API runs as in production.
# The initial migration REVOKEs UPDATE/DELETE on audit_log from this role.
# Leave empty in local dev to skip the REVOKE step.
APP_DB_ROLE=

# Embedding dimension. MUST match the vector(N) literal in migration 0001.
# 1024 = multilingual-e5-large (self-hosted, EU data residency).
# Changing this requires re-embedding every chunk AND a new migration.
EMBEDDING_DIM=1024

ENVIRONMENT=local

# --- Identity (#30) ---
# actor_id comes from a verified token's `sub` and from nowhere else. There is no flag
# that turns this off; outside ENVIRONMENT=local the app refuses to boot without both.
#
# The issuer URL only — the JWKS endpoint is discovered from it, so moving to an
# EU-hosted managed OIDC provider is this one line and no code.
# Matches the docker-compose Keycloak realm:
OIDC_ISSUER=http://localhost:8081/realms/luxmedicine

# Which audience a token must carry. Not cosmetic: without it, any token the issuer ever
# signed is accepted here, including other apps' users and service accounts.
# Keycloak does NOT set this by default — it puts `account` in aud and the client id in
# `azp`. keycloak/realm-luxmedicine.json adds the audience mapper that fixes it.
OIDC_AUDIENCE=luxmedicine-api

# This file is committed. Placeholders only — never real values.
# Put real secrets in .env, which .gitignore excludes.
# --- Extraction (#18) ---
# The Developer API. Resolves to generativelanguage.googleapis.com, which has NO regional
# pinning: tests/test_residency.py asserts this and refuses it for clinical text. Fine for
# measuring against invented fixtures; not fine for a clinician's question.
# GEMINI_API_KEY=

# Vertex AI with a European region — the only path that keeps ML processing in the EU,
# which is the same promise #6 self-hosts the embedding model for. Needs real credentials
# (ADC or a service account), NOT an API key: the two are mutually exclusive, and in the
# JavaScript SDK the key silently wins and the request goes global while the config still
# shows the region (google-gemini/gemini-cli#27984, open).
#
# GeminiExtractor reads these; refuse_unless_eu_processing() checks the URL that actually
# resolved rather than what was asked for.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=europe-west3

# LUXSHOP_KEY=

# Local development only — memoises the model call so asking the same thing twice costs one
# request (the free tier is 20/day per model). The app REFUSES to boot with this set outside
# ENVIRONMENT=local: the key is derived from the question, which redact_query (#28) could not
# reach, and a frozen reply from a non-deterministic model falsifies rejection_rate.
# LLM_CACHE_DIR=.cache/llm

# Which model extracts and translates. The free tier's binding limit is REQUESTS PER DAY,
# not tokens, and it is not uniform — measured 2026-07-17 from the AI Studio dashboard:
#
#   gemini-3-flash-preview / 2.5-flash / 3.5-flash      20 RPD   <- unusable for development
#   gemini-3.1-flash-lite                              500 RPD   15 RPM, 250K TPM
#   gemma-4-26b / gemma-4-31b                       14,400 RPD   30 RPM, 16K TPM
#
# Twenty a day does not survive one debugging session. 500 does, and it is exactly the size
# of a rejection_rate run. Billing is NOT required to measure this project — that was an
# assumption, and the dashboard disproved it.
GEMINI_MODEL=gemini-3.1-flash-lite
