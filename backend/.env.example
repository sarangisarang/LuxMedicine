# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://luxmed:luxmed@localhost:5433/luxmedicine

# The least-privileged DB role the API runs as in production.
# The initial migration REVOKEs UPDATE/DELETE on audit_log from this role.
# Leave empty in local dev to skip the REVOKE step.
APP_DB_ROLE=

# Embedding dimension. MUST match the vector(N) literal in migration 0001.
# 1024 = multilingual-e5-large (self-hosted, EU data residency).
# Changing this requires re-embedding every chunk AND a new migration.
EMBEDDING_DIM=1024

ENVIRONMENT=local

# --- Identity (#30) ---
# actor_id comes from a verified token's `sub` and from nowhere else. There is no flag
# that turns this off; outside ENVIRONMENT=local the app refuses to boot without both.
#
# The issuer URL only — the JWKS endpoint is discovered from it, so moving to an
# EU-hosted managed OIDC provider is this one line and no code.
# Matches the docker-compose Keycloak realm:
OIDC_ISSUER=http://localhost:8081/realms/luxmedicine

# Which audience a token must carry. Not cosmetic: without it, any token the issuer ever
# signed is accepted here, including other apps' users and service accounts.
# Keycloak does NOT set this by default — it puts `account` in aud and the client id in
# `azp`. keycloak/realm-luxmedicine.json adds the audience mapper that fixes it.
OIDC_AUDIENCE=luxmedicine-api

# This file is committed. Placeholders only — never real values.
# Put real secrets in .env, which .gitignore excludes.
# GEMINI_API_KEY=

# LUXSHOP_KEY=
