{
  "realm": "luxmedicine",
  "enabled": true,
  "accessTokenLifespan": 900,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "luxmedicine-api",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "luxmedicine-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "luxmedicine-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "luxmedicine-clinic-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "clinic_id",
            "claim.name": "clinic_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "luxmedicine-admin",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "dev-admin-secret"
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "clinic-admin",
        "description": "May mint registration invites for their own clinic (#51). An invite opens the tenant boundary, so this is held apart from an ordinary clinician."
      }
    ]
  },
  "users": [
    {
      "username": "dr.smith",
      "enabled": true,
      "emailVerified": true,
      "email": "dr.smith@example.invalid",
      "firstName": "Ada",
      "lastName": "Smith",
      "attributes": { "clinic_id": ["clinic-demo"] },
      "realmRoles": ["clinic-admin"],
      "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }]
    },
    {
      "username": "service-account-luxmedicine-admin",
      "enabled": true,
      "serviceAccountClientId": "luxmedicine-admin",
      "clientRoles": { "realm-management": ["manage-users", "view-realm"] }
    }
  ]
}
