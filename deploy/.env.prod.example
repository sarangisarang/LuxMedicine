# Copy to deploy/.env.prod (git-ignored) and fill in. Never commit the real file.
#   docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml up -d --build

# The base domain. Subdomains api.<domain> and auth.<domain> are derived from it in the compose
# file and the nginx template. DNS A/AAAA records for all three must point at this server.
LUX_DOMAIN=luxmedicin.de

# --- Postgres (application) ---
# Long random string. This is the app database's password; it never leaves the internal network.
POSTGRES_PASSWORD=

# --- Postgres (Keycloak's own database) ---
KEYCLOAK_DB_PASSWORD=

# --- Keycloak bootstrap admin (the master-realm admin, for the admin console) ---
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- The API's Keycloak service account (#51 registration) ---
# MUST differ from the local dev value 'dev-admin-secret'. Set the SAME value on the
# luxmedicine-admin client in Keycloak (admin console -> Clients -> luxmedicine-admin ->
# Credentials) after the realm is imported.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# --- Frontend per-user login (OIDC, BFF) ---
# The confidential secret of the luxmedicine-web Keycloak client. MUST differ from the committed
# dev value 'dev-web-secret'. Set the SAME value on the luxmedicine-web client in Keycloak
# (admin console -> Clients -> luxmedicine-web -> Credentials) after the realm is imported.
OIDC_CLIENT_SECRET=
# The passphrase the session cookie is encrypted under (JWE). Any long random string; rotating it
# logs everyone out. MUST differ from the committed dev default.
SESSION_SECRET=

# --- Inference: where the model runs, and therefore where clinical text goes ---------------
#
# Two paths, and GOOGLE_CLOUD_PROJECT alone chooses between them. No code change, no rebuild.
#
#   A) DEMO — free Gemini developer API. Set GEMINI_API_KEY, leave GOOGLE_CLOUD_PROJECT empty.
#      The endpoint is generativelanguage.googleapis.com, which is GLOBAL: Google's own docs
#      say you cannot know where processing happens. Requires ALLOW_NON_EU_INFERENCE=true.
#
#   B) VERTEX EU — set GOOGLE_CLOUD_PROJECT + a European GOOGLE_CLOUD_LOCATION and give it real
#      credentials. An API key is refused on this path (the SDK raises rather than silently
#      going global), which is the behaviour that makes the promise checkable.
#
# Fill in for (B), then verify — do not assume:
#
#     docker exec luxmedicine-prod-api-1 python -m app.cli.check_inference
#
# That prints the endpoint the SDK ACTUALLY resolved. A config that says europe-west3 and a
# client that talks to the global endpoint is a documented failure (google-genai #27984), so
# "I set the region" and "it runs in the region" are checked separately. Exit 0 only when the
# resolved endpoint is European.

GEMINI_MODEL=gemini-3.1-flash-lite

# (A) demo only — leave empty when using Vertex
GEMINI_API_KEY=

# (B) Vertex — the three lines to fill in, plus the key file in deploy/gcp/
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west3
# Path INSIDE the container. deploy/gcp/ on the host is mounted read-only at /run/gcp, and it
# is mounted whether or not it holds anything — so the switch needs no compose edit.
# e.g. GOOGLE_APPLICATION_CREDENTIALS=/run/gcp/vertex-sa.json
GOOGLE_APPLICATION_CREDENTIALS=

# Waives ONLY the EU-residency refusal — auth, audit and cache rules stay enforced, and
# main.py announces it loudly at every boot. TRUE is the demo posture (A). Set it to false the
# moment (B) works, so the guardrail is armed instead of bypassed: with it false, an extractor
# that resolves to a non-EU endpoint raises rather than sending anything.
#
# Defaulted to false in the compose file, so a forgotten line fails safe.
ALLOW_NON_EU_INFERENCE=true
